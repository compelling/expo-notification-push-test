{
  "expo": {
    "name": "PushTest",
    "slug": "pushtest",
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.compellingsoftware.privaterp",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
            [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],

    ],
    "android": {
      "package": "com.compellingsoftware.privaterp"
    }
  }
}
